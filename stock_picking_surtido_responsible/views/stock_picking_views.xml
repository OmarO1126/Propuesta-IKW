<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_surtido_responsible" model="ir.ui.view">
        <field name="name">stock.picking.form.surtido.responsible</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="user_id"
                       string="Responsable de surtido"
                       widget="many2one_avatar_user"
                       readonly="state in ['cancel', 'done']"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_surtido_responsible" model="ir.ui.view">
        <field name="name">stock.picking.list.surtido.responsible</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Responsable de surtido</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search_surtido_responsible" model="ir.ui.view">
        <field name="name">stock.picking.search.surtido.responsible</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='available']" position="after">
                <separator/>
                <filter name="my_surtidos"
                        string="Mis surtidos"
                        domain="[('user_id', '=', uid), ('picking_type_code', 'in', ('outgoing', 'internal')), ('state', 'in', ('confirmed', 'waiting', 'assigned'))]"/>
                <filter name="surtidos_without_responsible"
                        string="Sin responsable de surtido"
                        domain="[('user_id', '=', False), ('picking_type_code', 'in', ('outgoing', 'internal')), ('state', 'in', ('confirmed', 'waiting', 'assigned'))]"/>
                <filter name="surtidos_late"
                        string="Surtidos vencidos"
                        domain="[('picking_type_code', 'in', ('outgoing', 'internal')), ('state', 'in', ('confirmed', 'waiting', 'assigned')), '|', ('scheduled_date', '&lt;', current_date), ('date_deadline', '&lt;', current_date)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Responsable de surtido"
                        name="group_by_surtido_responsible"
                        context="{'group_by': 'user_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
