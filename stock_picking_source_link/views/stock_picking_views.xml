<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_source_link" model="ir.ui.view">
        <field name="name">stock.picking.form.source.link</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="sale_stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_source_sale_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not sale_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Solicitud</span>
                        <span class="o_stat_text">origen</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>