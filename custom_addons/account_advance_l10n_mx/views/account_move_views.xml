<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_move_form_inherit_advance_invoice" model="ir.ui.view">
    <field name="name">account.move.form.inherit.advance.invoice</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      
      <!-- Banner de aviso de anticipos disponibles (Puro texto, sin botón) -->
      <xpath expr="//sheet" position="before">
        <field name="has_available_advances" invisible="1"/>
        <div class="alert mb-0" role="alert" invisible="not has_available_advances" style="background-color: #28a745; color: white; border-color: #28a745;">
          <i class="fa fa-check-circle" title="Información" style="color: white;"/> 
          <strong>¡Aviso!</strong> Este cliente tiene facturas de anticipo con saldo disponible.
        </div>
      </xpath>

      <!-- Ubicar el campo booleano de anticipo junto al uso CFDI -->
      <xpath expr="//field[@name='l10n_mx_edi_usage']" position="after">
        <field name="is_advance_invoice"/>
        <field name="advance_invoice_id" readonly="1" invisible="not advance_invoice_id"/>
      </xpath>

      <!-- Pestañas dinámicas -->
      <xpath expr="//notebook" position="inside">
        <page string="Anticipos Aplicados" invisible="move_type != 'out_invoice' or is_advance_invoice == True">
          <field name="advance_line_ids" readonly="1">
            <list editable="bottom">
              <field name="advance_id"/>
              <field name="amount" sum="Total Aplicado"/>
              <field name="total_with_tax" sum="Total con Impuestos"/>
              <field name="currency_id"/>
            </list>
          </field>
        </page>

        <page string="Aplicaciones de Anticipo" invisible="not is_advance_invoice">
          <group>
            <field name="remaining_amount" readonly="1" string="Saldo disponible"/>
          </group>
          <field name="advance_usage_line_ids" readonly="1">
            <list editable="bottom">
              <field name="invoice_id"/>
              <field name="amount" sum="Total Aplicado"/>
              <field name="total_with_tax" sum="Total con Impuestos"/>
              <field name="currency_id"/>
            </list>
          </field>
        </page>
      </xpath>

      <!-- Botón de Aplicar Anticipo: Visible solo si la factura está timbrada y hay anticipos -->
      <xpath expr="//button[@name='action_post']" position="after">
        <button name="action_open_apply_advance_wizard" type="object" string="Aplicar Anticipo" class="btn-primary" 
                invisible="not has_available_advances"/>
      </xpath>

    </field>
  </record>
</odoo>