<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_apply_advance_invoice_wizard" model="ir.ui.view">
    <field name="name">apply.advance.invoice.wizard.form</field>
    <field name="model">apply.advance.invoice.wizard</field>
    <field name="arch" type="xml">
      <form string="Aplicar Múltiples Anticipos">
        <group>
          <field name="invoice_id" readonly="1"/>
          <field name="invoice_amount_residual" readonly="1" widget="monetary"/>
          <field name="partner_id" invisible="1"/>
          <field name="currency_id" invisible="1"/>
        </group>
        <separator string="Anticipos Disponibles"/>
        
        <field name="line_ids" nolabel="1">
          <list editable="bottom">
            <field name="currency_id" column_invisible="True"/>
            <field name="advance_id" options="{'no_create': True, 'no_open': True}"/>
            <field name="remaining_amount" readonly="1"/>
            <field name="amount"/>
          </list>
        </field>
        
        <footer>
          <button string="Aplicar y Vincular" type="object" name="action_apply_and_link" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>