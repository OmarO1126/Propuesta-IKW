#: code:addons/advances_on_multiple_invoices/wizard/multiple_invoice_payment_wizard.py:0
msgid ""
"All PPD invoices must have the same customer RFC for the payment "
"complement."
msgstr "Todas las facturas PPD deben tener el mismo RFC receptor para el complemento de pago."

#. module: advances_on_multiple_invoices
#. odoo-python
#: code:addons/advances_on_multiple_invoices/wizard/multiple_invoice_payment_wizard.py:0
msgid ""
"PUE invoices must be settled in full by this payment. Documents with a "
"remaining balance: %(documents)s"
msgstr "Las facturas PUE deben liquidarse totalmente con este pago. Documentos que conservarían saldo: %(documents)s"

#. module: advances_on_multiple_invoices
#. odoo-python
#: code:addons/advances_on_multiple_invoices/wizard/multiple_invoice_payment_wizard.py:0
msgid ""
"PUE invoices can only be paid no later than the last day of their invoice "
"month. Reissue them as PPD before registering this payment: %(documents)s"
msgstr "Las facturas PUE sólo pueden pagarse a más tardar el último día del mes de la factura. Reexpídelas como PPD antes de registrar este pago: %(documents)s"

#. module: advances_on_multiple_invoices
#. odoo-python
#: code:addons/advances_on_multiple_invoices/wizard/multiple_invoice_payment_wizard.py:0
msgid ""
"The SAT payment way must match the payment way stamped on every PUE "
"invoice. Documents with a different way: %(documents)s"
msgstr "La forma de pago SAT debe coincidir con la timbrada en cada factura PUE. Documentos con una forma distinta: %(documents)s"

#. module: advances_on_multiple_invoices
#: model_terms:ir.ui.view,arch_db:advances_on_multiple_invoices.view_multiple_invoice_payment_wizard_form
