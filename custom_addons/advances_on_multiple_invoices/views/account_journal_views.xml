<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_remission_payments" model="ir.ui.view">
        <field name="name">account.journal.form.remission.payments</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type'][1]" position="after">
                <field name="use_for_remission_payments"
                       invisible="type not in ('bank', 'cash')"/>
            </xpath>
        </field>
    </record>
</odoo>
