<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_hide_payment_cfdi_on_pue" model="ir.ui.view">
        <field name="name">account.move.form.hide.payment.cfdi.on.pue</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_mx_edi.account_move_form_inherit_l10n_mx_edi"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_cfdi']" position="attributes">
                <attribute name="invisible">not multiple_invoice_visible_cfdi_document_ids</attribute>
            </xpath>
            <xpath expr="//page[@name='page_cfdi']/field[@name='l10n_mx_edi_document_ids']" position="attributes">
                <attribute name="name">multiple_invoice_visible_cfdi_document_ids</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_distributed_payment" model="ir.ui.view">
        <field name="name">account.out.invoice.list.distributed.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_force_register_payment']" position="after">
                <button name="%(action_multiple_invoice_payment_wizard)d"
                        type="action"
                        string="Distribute payment"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
