<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_receipt_distributed_page_spacing"
              inherit_id="account.report_payment_receipt"
              priority="30">
        <xpath expr="//t[@t-call='web.html_container']" position="before">
            <t t-set="is_distributed_receipt"
               t-value="bool(docs and docs[0].multiple_invoice_distribution)"/>
            <t t-set="has_compact_pdf_overlay"
               t-value="is_distributed_receipt and docs[0].env.context.get('compact_receipt_pdf_overlay')"/>
            <t t-set="data_report_margin_top"
               t-value="44 if is_distributed_receipt else None"/>
            <t t-set="data_report_header_spacing"
               t-value="26 if is_distributed_receipt and not has_compact_pdf_overlay else None"/>
        </xpath>
    </template>

    <template id="report_payment_receipt_distributed"
              inherit_id="l10n_mx_edi.report_payment_document"
              priority="30">
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">{{'advances_on_multiple_invoices.payment_remission_contact_layout' if o.multiple_invoice_distribution and o.distributed_document_kind == 'remission' else 'advances_on_multiple_invoices.payment_compact_company_layout' if o.multiple_invoice_distribution else 'web.external_layout'}}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/h3" position="attributes">
            <attribute name="t-if">not o.multiple_invoice_distribution</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.memo']/parent::div" position="replace"/>

        <xpath expr="//div[hasclass('page')]/div[hasclass('mb-4')]" position="before">
            <t t-if="o.multiple_invoice_distribution">
                <t t-set="cfdi" t-value="values.get('cfdi')"/>
                <t t-set="payer" t-value="o.distributed_payer_id or o.partner_id"/>
                <t t-set="payer_legal" t-value="payer.commercial_partner_id or payer"/>
                <t t-set="payer_address" t-value="payer if payer.street or payer.street2 or payer.zip else payer_legal"/>
                <t t-set="payer_regime" t-value="payer.l10n_mx_edi_fiscal_regime or payer_legal.l10n_mx_edi_fiscal_regime"/>
                <t t-set="regime_labels" t-value="dict(payer._fields['l10n_mx_edi_fiscal_regime']._description_selection(o.env))"/>
                <t t-set="regime_label" t-value="regime_labels.get(payer_regime) or ''"/>
                <t t-set="payer_place" t-value="o._get_receipt_payer_address_extras(payer_address)"/>
                <t t-set="payment_cfdi_node" t-value="cfdi.get('cfdi_node') if cfdi else None"/>
                <t t-set="payment_receiver"
                   t-value="payment_cfdi_node.xpath('./*[local-name()=&quot;Receptor&quot;]') if payment_cfdi_node is not None else []"/>
                <t t-set="payment_usage" t-value="payment_receiver[0].get('UsoCFDI') if payment_receiver else False"/>
                <div name="multiple_invoice_payment_summary"
                     style="margin: 7px 0 16px; border: 1px solid #b8b8b8; page-break-inside: avoid; font-size: 12px;">
                    <div style="background-color: #b8b8b8; padding: 2px 5px; font-weight: bold;">Datos pagador</div>
                    <div style="padding: 3px 5px 5px;">
                        <div style="overflow: hidden;">
                            <div style="float: left; width: 40%;">
                                <strong>Cliente:</strong> <span name="payer_client_value" t-out="payer.ref or payer_legal.ref or ''"/>
                            </div>
                            <div style="float: left; width: 29%;">
                                <strong>R.F.C.:</strong> <span name="payer_rfc_value" t-out="payer.vat or payer_legal.vat or ''"/>
                            </div>
                            <div style="float: left; width: 31%;">
                                <strong>Uso de CFDI:</strong> <span name="payer_cfdi_usage" t-out="payment_usage or ''"/>
                                <span t-if="payment_usage == 'CP01'"> - Pagos</span>
                                <span t-if="payment_usage == 'P01'"> - Por definir</span>
                            </div>
                        </div>
                        <div>
                            <strong style="display: inline-block; width: 15%;">Régimen fiscal:</strong>
                            <span name="payer_regime_value"
                                  t-out="(regime_label if regime_label.startswith(payer_regime) else (payer_regime + ' - ' + regime_label if regime_label else payer_regime)) if payer_regime else ''"/>
                        </div>
                        <div>
                            <strong style="display: inline-block; width: 15%;">Razón social:</strong>
                            <span t-out="payer_legal.name or ''"/>
                        </div>
                        <div>
                            <strong style="display: inline-block; width: 15%;">Dirección:</strong>
                            <span t-out="payer_address.street or ''"/>
                            <span t-if="payer_address.street2"><t t-if="payer_address.street">, </t><span t-out="payer_address.street2"/></span>
                        </div>
                        <div style="overflow: hidden;">
                            <div style="float: left; width: 78%;">
                                <strong style="display: inline-block; width: 19%;">Municipio:</strong>
                                <span t-out="payer_place['municipality'] or ''"/>
                                <span t-if="payer_address.state_id"><t t-if="payer_place['municipality']">, </t><span t-field="payer_address.state_id.name"/></span>
                                <span t-if="payer_address.country_id"><t t-if="payer_place['municipality'] or payer_address.state_id">, </t><span t-field="payer_address.country_id.name"/></span>
                            </div>
                            <div style="float: left; width: 22%;">
                                <strong>C.P.:</strong> <span name="payer_zip_value" t-out="payer_address.zip or ''"/>
                            </div>
                        </div>
                    </div>
                </div>
                <t t-set="payment_concepts"
                   t-value="payment_cfdi_node.xpath('./*[local-name()=&quot;Conceptos&quot;]/*[local-name()=&quot;Concepto&quot;]') if payment_cfdi_node is not None else []"/>
                <table t-if="o.distributed_document_kind != 'remission' and payment_concepts"
                       name="multiple_invoice_payment_concepts"
                       style="width: 100%; table-layout: fixed; border-collapse: collapse; margin: 0 0 14px; font-size: 11px; text-align: center; page-break-inside: avoid;">
                    <thead style="background-color: #f0f0f0;">
                        <tr>
                            <th style="width: 8%; padding: 4px 3px; border: 1px solid #d8dadd;">Cantidad</th>
                            <th style="width: 11%; padding: 4px 3px; border: 1px solid #d8dadd;">No. ident.</th>
                            <th style="width: 10%; padding: 4px 3px; border: 1px solid #d8dadd;">Unidad</th>
                            <th style="width: 15%; padding: 4px 3px; border: 1px solid #d8dadd;">Clave prod./serv.</th>
                            <th style="width: 10%; padding: 4px 3px; border: 1px solid #d8dadd;">Unid. SAT</th>
                            <th style="width: 25%; padding: 4px 3px; border: 1px solid #d8dadd;">Descripción</th>
                            <th style="width: 11%; padding: 4px 3px; border: 1px solid #d8dadd;">Valor unitario</th>
                            <th style="width: 10%; padding: 4px 3px; border: 1px solid #d8dadd;">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="payment_concepts" t-as="concept">
                            <td style="padding: 4px 3px; border: 1px solid #d8dadd;" t-out="concept.get('Cantidad') or ''"/>
                            <td style="padding: 4px 3px; border: 1px solid #d8dadd; overflow-wrap: anywhere;" t-out="concept.get('NoIdentificacion') or ''"/>
                            <td style="padding: 4px 3px; border: 1px solid #d8dadd;" t-out="concept.get('Unidad') or concept.get('ClaveUnidad') or ''"/>
                            <td style="padding: 4px 3px; border: 1px solid #d8dadd;" t-out="concept.get('ClaveProdServ') or ''"/>
                            <td style="padding: 4px 3px; border: 1px solid #d8dadd;" t-out="concept.get('ClaveUnidad') or ''"/>
                            <td style="padding: 4px 3px; border: 1px solid #d8dadd; overflow-wrap: anywhere;" t-out="concept.get('Descripcion') or ''"/>
                            <td style="padding: 4px 3px; border: 1px solid #d8dadd;" t-out="concept.get('ValorUnitario') or ''"/>
                            <td style="padding: 4px 3px; border: 1px solid #d8dadd;" t-out="concept.get('Importe') or ''"/>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('page')]/div[hasclass('mb-4')]" position="attributes">
            <attribute name="t-if">not o.multiple_invoice_distribution</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.partner_id']/parent::div" position="attributes">
            <attribute name="t-if">o.partner_type and not o.multiple_invoice_distribution</attribute>
        </xpath>

        <xpath expr="//span[@t-field='o.amount']" position="after">
            <div class="mt-1" t-if="o.memo and not o.distributed_payment_primary_id"
                 name="multiple_invoice_operation_number">
                <strong>Núm. de operación:</strong>
                <span t-field="o.memo"/>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('page')]/div[hasclass('mb-4')]" position="after">
            <div t-if="not o.multiple_invoice_distribution and o.receipt_sequence"
                 name="internal_rp_receipt_number"
                 class="mb-3">
                <strong>Folio interno del recibo:</strong>
                <span>Serie: RP</span>
                <span>Folio: <t t-out="'%05d' % o.receipt_sequence"/></span>
            </div>
            <t t-if="o.multiple_invoice_distribution">
                <t t-set="payment_cfdi_node"
                   t-value="(values.get('cfdi') or {}).get('cfdi_node')"/>
                <div t-if="o.distributed_document_kind == 'remission'"
                     class="alert alert-warning py-2 my-2"
                     name="multiple_invoice_remission_notice">
                    <strong>RECIBO DE PAGO DE REMISIÓN</strong>
                    <div>Documento contable interno: no es un CFDI.</div>
                </div>
                <div class="mt-3" name="multiple_invoice_payment_methods">
                    <h4 style="color: #714B67; border-bottom: 2px solid #714B67; padding-bottom: 5px;">
                        Desglose por forma de pago
                    </h4>
                    <t t-foreach="o.distributed_group_payment_ids" t-as="component">
                        <t t-set="component_cfdi_bank_values"
                           t-value="component._get_multiple_invoice_payment_cfdi_bank_values(payment_cfdi_node)"/>
                        <t t-set="component_bank_info"
                           t-value="component._get_multiple_invoice_payment_bank_report_values(component_cfdi_bank_values)"/>
                        <div class="mb-3" style="border: 1px solid #d8dadd; border-radius: 4px;">
                            <div name="multiple_invoice_method_identity"
                                 style="page-break-inside: avoid; break-inside: avoid; page-break-after: avoid;">
                            <div class="px-3 py-2"
                                 style="background-color: #f3eef2; border-bottom: 1px solid #d8dadd;">
                                <table style="width: 100%; border: 0; border-collapse: collapse;">
                                    <tr>
                                        <td style="width: 75%; padding: 0; border: 0; vertical-align: middle;">
                                            <strong>
                                                Método <span t-field="component.distributed_payment_component_sequence"/>:
                                                <span t-if="component.l10n_mx_edi_payment_method_id"
                                                      t-field="component.l10n_mx_edi_payment_method_id"/>
                                                <span t-else="">No aplica SAT</span>
                                            </strong>
                                        </td>
                                        <td style="width: 25%; padding: 0; border: 0; text-align: right; vertical-align: middle; white-space: nowrap;">
                                            <strong style="font-size: 1.1rem;">
                                                <span t-field="component.amount"
                                                      t-options="{'widget': 'monetary', 'display_currency': component.currency_id}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <table style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 0.9rem; margin: 6px 0;">
                              <tr>
                                <td style="width: 33%; vertical-align: top; padding: 5px 10px; border: 0; overflow-wrap: anywhere;">
                                    <div><strong>Fecha:</strong> <span t-field="component.date"/></div>
                                    <div><strong>Núm. de operación:</strong>
                                        <span t-if="component.memo" t-field="component.memo"/>
                                        <span t-else="">Sin registrar</span>
                                    </div>
                                </td>
                                <td style="width: 33%; vertical-align: top; padding: 5px 10px; border: 0; overflow-wrap: anywhere;">
                                    <div><strong>Banco ordenante:</strong>
                                        <span t-if="component_cfdi_bank_values.get('payment_info', {}).get('from_account_name')"
                                              t-out="component_cfdi_bank_values['payment_info']['from_account_name']"/>
                                        <span t-else="">No informado en XML</span>
                                    </div>
                                    <div><strong>Cuenta ordenante:</strong>
                                        <span t-if="component_bank_info['emitter_account']"
                                              t-out="component_bank_info['emitter_account']"/>
                                        <span t-else="">No aplica / no registrada</span>
                                    </div>
                                </td>
                                <td style="width: 34%; vertical-align: top; padding: 5px 10px; border: 0; overflow-wrap: anywhere;">
                                    <div><strong>Cuenta receptora:</strong>
                                        <span t-if="component_bank_info['receiver_account']"
                                              t-out="component_bank_info['receiver_account']"/>
                                        <span t-else="">No registrada</span>
                                    </div>
                                    <div t-if="component_bank_info['receiver_bank_name']">
                                        <strong>Banco receptor:</strong>
                                        <span t-out="component_bank_info['receiver_bank_name']"/>
                                    </div>
                                </td>
                              </tr>
                            </table>
                            </div>
                            <table class="table table-sm mb-0" style="font-size: 0.82rem;">
                                <thead style="background-color: #fafafa; display: table-header-group;">
                                    <tr>
                                        <th>Documento</th>
                                        <th>UUID</th>
                                        <th>Política</th>
                                        <th class="text-end">Saldo anterior</th>
                                        <th class="text-end">Aplicado</th>
                                        <th class="text-end">Saldo insoluto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="component.invoice_distribution_ids.sorted(lambda line: (line.sequence, line.id))"
                                        t-as="distribution"
                                        style="page-break-inside: avoid; break-inside: avoid;">
                                        <td>
                                            <span t-out="distribution.invoice_id.name"/>
                                            <span t-if="distribution.invoice_id.invoice_origin"
                                                  t-out="' (%s)' % distribution.invoice_id.invoice_origin"/>
                                        </td>
                                        <td>
                                            <small t-if="o.distributed_document_kind == 'remission'">No aplica</small>
                                            <small t-elif="distribution.invoice_id.l10n_mx_edi_cfdi_uuid"
                                                   t-field="distribution.invoice_id.l10n_mx_edi_cfdi_uuid"/>
                                            <small t-else="">Sin UUID</small>
                                        </td>
                                        <td><span t-field="distribution.invoice_id.l10n_mx_edi_payment_policy"/></td>
                                        <td class="text-end">
                                            <span t-field="distribution.previous_residual"
                                                  t-options="{'widget': 'monetary', 'display_currency': distribution.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="distribution.amount"
                                                  t-options="{'widget': 'monetary', 'display_currency': distribution.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="distribution.remaining_residual"
                                                  t-options="{'widget': 'monetary', 'display_currency': distribution.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div t-if="component.invoice_distribution_ids.invoice_id.filtered(lambda invoice: invoice.l10n_mx_edi_payment_policy == 'PUE')"
                                 class="px-3 py-1 text-muted" style="font-size: 0.75rem;">
                                Las líneas PUE son aplicaciones contables y no forman parte del complemento de pago.
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>

        <xpath expr="//span[@t-field='o.amount']" position="replace">
            <span t-if="o.distributed_is_group_primary"
                  t-field="o.distributed_group_total_amount"
                  t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
            <span t-else="" t-field="o.amount"/>
        </xpath>

        <xpath expr="//table[@name='table_l10n_mx_edi_payment_info']"
               position="attributes">
            <attribute name="t-if">payment_info and not o.multiple_invoice_distribution</attribute>
        </xpath>

        <xpath expr="//table[@name='invoices']" position="attributes">
            <attribute name="t-if">values['display_invoices'] and not o.multiple_invoice_distribution</attribute>
        </xpath>

        <xpath expr="//div[@name='l10n_mx_edi_payment_method']" position="replace">
            <div t-if="cfdi and o.l10n_mx_edi_payment_method_id and not o.multiple_invoice_distribution"
                 class="col-6" name="l10n_mx_edi_payment_method">
                <strong>Forma de pago:</strong>
                <span t-out="'%s - %s' % (o.l10n_mx_edi_payment_method_id.code, o.l10n_mx_edi_payment_method_id.name)"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='l10n_mx_edi_supplier_rfc']" position="attributes">
            <attribute name="t-if">cfdi and not o.multiple_invoice_distribution and o.company_id.vat != cfdi['supplier_rfc']</attribute>
        </xpath>
    </template>

    <template id="payment_compact_company_layout">
        <t t-set="company" t-value="o.company_id.sudo()"/>
        <t t-set="company_address" t-value="company.partner_id"/>
        <t t-set="company_place" t-value="o._get_receipt_payer_address_extras(company_address)"/>
        <t t-set="header_cfdi" t-value="o._get_payment_receipt_report_values().get('cfdi') or {}"/>
        <t t-set="header_node" t-value="header_cfdi.get('cfdi_node')"/>
        <t t-set="header_stamped" t-value="bool(header_cfdi.get('uuid') and header_node is not None)"/>
        <t t-set="receipt_emission"
           t-value="(header_cfdi.get('emission_date_str') if header_stamped else False) or o.date.strftime('%d/%m/%Y')"/>
        <div t-attf-class="header o_company_#{company.id}_layout"
             t-if="not o.env.context.get('compact_receipt_pdf_overlay')"
             name="multiple_invoice_company_header"
             style="border-bottom: 1px solid #d8dadd; padding-bottom: 5px;">
            <table style="width: 100%; border-collapse: collapse; border: 0; table-layout: fixed;">
                <tr>
                    <td style="width: 30%; border: 0; padding: 0 8px 0 0; vertical-align: middle;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                             alt="Logo" style="max-width: 145px; max-height: 63px; width: auto; height: auto;"/>
                    </td>
                    <td style="width: 38%; border: 0; padding: 0 8px; text-align: center; vertical-align: middle; font-size: 12px; line-height: 1.25;">
                        <strong style="font-size: 18px; line-height: 1.15;" t-field="company.name"/>
                        <div>
                            <span t-if="company_address.street" t-field="company_address.street"/>
                            <span t-if="company_address.street2"><t t-if="company_address.street">, </t><span t-field="company_address.street2"/></span>
                        </div>
                        <div t-if="company_place['colony'] or company_place['locality'] or company_place['municipality']">
                            <span t-if="company_place['colony']" t-out="company_place['colony']"/>
                            <span t-if="company_place['locality'] and company_place['locality'] != company_place['municipality']"><t t-if="company_place['colony']">, </t><span t-out="company_place['locality']"/></span>
                            <span t-if="company_place['municipality']"><t t-if="company_place['colony'] or (company_place['locality'] and company_place['locality'] != company_place['municipality'])">, </t><span t-out="company_place['municipality']"/></span>
                        </div>
                        <div>
                            <span t-if="company_address.city and company_address.city != company_place['municipality']"><span t-field="company_address.city"/></span>
                            <span t-if="company_address.zip"><t t-if="company_address.city and company_address.city != company_place['municipality']">, </t>C.P. <span t-field="company_address.zip"/></span>
                        </div>
                        <div>
                            <span t-if="company_address.state_id" t-field="company_address.state_id.name"/>
                            <span t-if="company_address.country_id"><t t-if="company_address.state_id">, </t><span t-field="company_address.country_id.name"/></span>
                        </div>
                    </td>
                    <td style="width: 32%; border: 0; padding: 0 0 0 8px; text-align: center; vertical-align: middle; font-size: 8px; line-height: 1.2; overflow-wrap: anywhere;">
                        <strong>Folio Fiscal:</strong>
                        <div t-out="header_cfdi.get('uuid') if header_stamped else 'No timbrado'"/>
                        <div t-if="header_stamped"><strong>Tipo de comprobante:</strong> P - Pago</div>
                        <div t-else="">Documento interno de pago</div>
                        <div t-if="o.receipt_sequence">
                            <strong>Serie interna:</strong> RP
                            <strong>Folio interno:</strong>
                            <span t-out="'%05d' % o.receipt_sequence"/>
                        </div>
                        <div><strong>Fecha de emisión:</strong> <span t-out="receipt_emission"/></div>
                    </td>
                </tr>
            </table>
        </div>
        <div t-attf-class="article o_report_layout_standard o_table_standard o_company_#{company.id}_layout o_snail_mail"
             t-att-data-oe-model="o._name"
             t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <div t-attf-class="footer text-muted o_company_#{company.id}_layout"
             style="border-top: 1px solid #d8dadd; padding-top: 4px; font-size: 9px;">
            <span t-if="company.vat">RFC: <span t-field="company.vat"/></span>
            <span class="float-end">Página <span class="page"/> / <span class="topage"/></span>
        </div>
    </template>

    <template id="payment_remission_contact_layout">
        <t t-set="issuer"
           t-value="o.distributed_group_distribution_ids.invoice_id.remission_issuer_partner_id[:1].sudo()"/>
        <div class="header" t-if="not o.env.context.get('compact_receipt_pdf_overlay')"
             style="border-bottom: 1px solid #714B67; padding-bottom: 8px;">
            <strong t-if="issuer" style="font-size: 16px;" t-field="issuer.name"/>
            <strong t-else="" style="font-size: 16px;">Emisor de remisión no registrado</strong>
            <div t-if="issuer and issuer.vat">RFC: <span t-field="issuer.vat"/></div>
            <div t-if="issuer and issuer.street" t-field="issuer.street"/>
            <div t-if="issuer and issuer.street2" t-field="issuer.street2"/>
            <div t-if="issuer and (issuer.zip or issuer.city or issuer.state_id or issuer.country_id)">
                <span t-if="issuer.zip" t-field="issuer.zip"/>
                <span t-if="issuer.city" t-field="issuer.city"/>
                <span t-if="issuer.state_id" t-field="issuer.state_id.name"/>
                <span t-if="issuer.country_id" t-field="issuer.country_id.name"/>
            </div>
        </div>
        <div class="article" t-att-data-oe-model="o._name"
             t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <div class="footer text-muted" style="border-top: 1px solid #ddd; padding-top: 4px;">
            <span>Recibo interno de remisión</span>
