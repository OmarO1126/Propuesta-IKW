<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_remission_issuer" model="ir.ui.view">
        <field name="name">res.config.settings.form.remission.issuer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="standardized_offers_setting" position="after">
                <setting id="remission_issuer_contact_setting"
                         string="Contacto emisor de remisiones"
                         help="Un solo contacto guarda la razón social y domicilio impresos en las remisiones.">
                    <field name="remission_issuer_partner_id"
                           readonly="1"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <div class="text-muted mt8">
                        Abre el contacto EMISOR-REMISION para editar su razón social, RFC y domicilio.
                    </div>
                </setting>
            </setting>
        </field>
    </record>

    <record id="sale_order_form_remission" model="ir.ui.view">
        <field name="name">sale.order.form.remission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_remission"
                        type="object" string="Imprimir remisión"
                        class="btn-secondary"
                        invisible="not is_remission"
                        help="Imprime lo recogido en la salida, aunque aún no esté completada."/>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']" position="before">
                <widget name="web_ribbon" text="REMISIÓN" bg_color="text-bg-warning"
                        invisible="not is_remission"/>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="before">
                <field name="is_remission" readonly="state not in ('draft', 'sent')"/>
                <label for="remission_issuer_partner_id" invisible="not is_remission"/>
                <div class="o_row" invisible="not is_remission">
                    <field name="remission_issuer_partner_id"
                           nolabel="1" readonly="1"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <button name="action_open_remission_issuer_contact"
                            type="object" string="Editar" icon="fa-pencil"
                            help="Editar el contacto emisor de remisiones"
                            class="btn-link ms-2"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_form_remission" model="ir.ui.view">
        <field name="name">stock.picking.form.remission</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="sale_stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="before">
                <widget name="web_ribbon" text="REMISIÓN" bg_color="text-bg-warning"
                        invisible="not is_remission"/>
            </xpath>
            <xpath expr="//field[@name='sale_id']" position="after">
                <field name="is_remission" readonly="1"/>
                <field name="remission_issuer_partner_id"
                       invisible="not is_remission"
                       readonly="1"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="remission_issuer_company_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_remission_marker" model="ir.ui.view">
        <field name="name">account.move.form.remission.marker</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="before">
                <widget name="web_ribbon" text="REMISIÓN" bg_color="text-bg-warning"
                        invisible="not is_remission"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_remission" readonly="state != 'draft'"/>
                <field name="remission_issuer_partner_id"
                       invisible="not is_remission"
                       readonly="1"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="remission_issuer_company_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="partner_form_remission_issuer" model="ir.ui.view">
        <field name="name">res.partner.form.remission.issuer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="is_remission_issuer_contact" invisible="1"/>
                <widget name="web_ribbon" text="EMISOR DE REMISIONES"
                        bg_color="text-bg-info"
                        invisible="not is_remission_issuer_contact"/>
                <div class="alert alert-info mt-2" role="status"
                     invisible="not is_remission_issuer_contact">
                    Este es el contacto único para el formato de remisiones.
                    Edita aquí la razón social, RFC y domicilio. Referencia interna: EMISOR-REMISION.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
