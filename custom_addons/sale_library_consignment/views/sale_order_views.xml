<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia en la Orden de Venta -->
    <record id="view_order_form_inherit_consignados" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.consignados</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ver_consignados" 
                        type="object" 
                        string="Consignados" 
                        class="btn-secondary" 
                        invisible="not tiene_contactos_relacionados or state in ('sale', 'done')"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="consignado_domain_ids" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de Búsqueda para filtrar los consignados -->
    <record id="view_sale_consignado_search" model="ir.ui.view">
        <field name="name">sale.consignado.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar Consignado">
                <field name="name" string="Nombre / Sucursal" filter_domain="['|', ('name', 'ilike', self), ('street', 'ilike', self)]"/>
                <field name="city" string="Ciudad"/>
            </search>
        </field>
    </record>

    <!-- Vista Kanban de los consignados para la ventana flotante -->
    <record id="view_sale_consignado_wizard_kanban" model="ir.ui.view">
        <field name="name">sale.consignado.wizard.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="street"/>
                <field name="street2"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="zip"/>
                <field name="country_id"/>
                <field name="avatar_128"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center w-100 p-2" style="cursor: pointer;">
                            <div class="flex-shrink-0 me-3" style="width: 40px; height: 40px;">
                                <field name="avatar_128" widget="image" options="{'preview_image': 'avatar_128', 'size': [40, 40]}"/>
                            </div>
                            <div class="flex-grow-1">
                                <button type="object" name="seleccionar_consignado" t-att-args="[record.id.raw_value]" class="btn btn-link text-start p-0 text-decoration-none">
                                    <strong class="o_kanban_record_title oe_partner_heading text-primary fs-6">
                                        <field name="name"/>
                                    </strong>
                                </button>
                                <div class="text-muted small">
                                    <field name="street"/><t t-if="record.street2.value">, <field name="street2"/></t>
                                    <br/>
                                    <t t-if="record.city.value"><field name="city"/>, </t>
                                    <t t-if="record.state_id.value"><field name="state_id"/> </t>
                                    <t t-if="record.zip.value"><field name="zip"/></t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>