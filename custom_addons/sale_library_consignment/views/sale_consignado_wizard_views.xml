<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_consignado_wizard_kanban" model="ir.ui.view">
        <field name="name">sale.consignado.wizard.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="street"/>
                <field name="street2"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="zip"/>
                <field name="country_id"/>
                <field name="avatar_128"/>
                <templates>
                    <t t-name="card">
                        <!-- Usamos un enlace de tipo objeto que llama al método de la orden pasando el id -->
                        <div class="d-flex align-items-center w-100 p-2" style="cursor: pointer;">
                            <div class="flex-shrink-0 me-3" style="width: 40px; height: 40px;">
                                <field name="avatar_128" widget="image" options="{'preview_image': 'avatar_128', 'size': [40, 40]}"/>
                            </div>
                            <div class="flex-grow-1">
                                <button type="object" name="asignar_y_cerrar" t-att-args="[record.id.raw_value]" class="btn btn-link text-start p-0 text-decoration-none">
                                    <strong class="o_kanban_record_title oe_partner_heading text-primary fs-6">
                                        <field name="name"/>
                                    </strong>
                                </button>
                                <div class="text-muted small">
                                    <field name="street"/><t t-if="record.street2.value">, <field name="street2"/></t>
                                    <br/>
                                    <t t-if="record.city.value"><field name="city"/>, </t>
                                    <t t-if="record.state_id.value"><field name="state_id"/> </t>
                                    <t t-if="record.zip.value"><field name="zip"/></t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>